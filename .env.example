POSTGRES_DB=bdo_companion
POSTGRES_DATA_VOLUME=black-market-postgres-data
POSTGRES_DATA_EXTERNAL=false
POSTGRES_USER=bdo
POSTGRES_PASSWORD=bdo_local_only
DATABASE_URL=postgresql://bdo:bdo_local_only@localhost:5432/bdo_companion
CONTAINER_DATABASE_URL=postgresql://bdo:bdo_local_only@postgres:5432/bdo_companion
PORT=3000
WEB_ORIGIN=http://localhost:4200
APP_ENV=local
MARKET_PROVIDER_ENABLED=true
MARKET_COLLECTOR_ENABLED=false
MARKET_BOARD_COLLECTOR_ENABLED=false
MARKET_TRACKED_ITEMS=
# Firebase identity is optional locally. Configure all values together.
# FIREBASE_ADMIN_CREDENTIALS_BASE64 is server-only; never expose it to the web container.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_ADMIN_CREDENTIALS_BASE64=
STEAM_OPENID_CALLBACK_URL=
# Staging only; leave blank outside the isolated staging environment.
STAGING_TEST_FIREBASE_UID=
ROADMAP_ADMIN_FIREBASE_UIDS=
# Legacy Supabase Auth settings are removed after the Firebase migration is complete.
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
# Public deployment origin; required for sitemap and canonical URLs in production.
PUBLIC_SITE_URL=
CATALOG_ASSETS_DIR=../../data/assets
# Optional after publishing versioned item assets to a public CDN:
# CATALOG_ASSETS_PUBLIC_URL=https://assets.your-domain.com
# Optional services: disabled until configured and validated.
ANALYTICS_ENABLED=false
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://us.i.posthog.com
TRUST_PROXY=false
CONTACT_EMAIL=enzobellussi3@gmail.com
DATA_CONTROLLER_NAME=Bellussi
# Production uses an exclusive volume and a separate .env.production (never commit).
PRODUCTION_POSTGRES_VOLUME=black-market-production-data
# Production only: migration URL above uses the owner; runtime URL uses black_market_app.
# Generate a different random password (at least 32 characters), never reuse the owner password.
POSTGRES_APP_PASSWORD=
RUNTIME_DATABASE_URL=
# Select an immutable release tag/digest in production, keeping the previous release for rollback.
APP_IMAGE=black-market:production
