{
  "name": "@bdo/calculators",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "browser": "./dist/browser/workspace.js",
      "require": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @bdo/domain build && tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "typecheck": "pnpm --filter @bdo/domain build && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bdo/domain": "workspace:*",
    "@bdo/shared": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
