{
  "name": "black-market",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @bdo/web start",
    "dev:api": "pnpm --filter @bdo/calculators build && pnpm --filter @bdo/database build && pnpm --filter @bdo/api start:dev",
    "lint": "pnpm lint:packages && pnpm lint:ocr && pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test scripts/generate-synthetic-ocr-dataset.test.mjs scripts/scrape-bdo-screenshots.test.mjs scripts/benchmark-ocr.test.mjs scripts/validate-ocr-corpus.test.mjs scripts/validate-screen-ocr.test.mjs scripts/real-ocr-corpus.test.mjs scripts/evaluate-scan-reader-output.test.mjs scripts/measured-quantity-label.test.mjs",
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @bdo/database db:generate",
    "db:migrate": "pnpm --filter @bdo/database db:migrate",
    "db:check": "pnpm --filter @bdo/database db:check",
    "lint:packages": "eslint \"packages/**/*.{ts,mts}\" \"*.mjs\" \"config/**/*.mjs\" --max-warnings=0",
    "lint:ocr": "eslint \"scripts/generate-synthetic-ocr-dataset.mjs\" \"scripts/generate-synthetic-ocr-dataset.test.mjs\" \"scripts/scrape-bdo-screenshots.mjs\" \"scripts/scrape-bdo-screenshots.test.mjs\" \"scripts/benchmark-ocr.mjs\" \"scripts/benchmark-ocr.test.mjs\" \"scripts/validate-ocr-corpus.mjs\" \"scripts/validate-ocr-corpus.test.mjs\" \"scripts/validate-screen-ocr.mjs\" \"scripts/validate-screen-ocr.test.mjs\" --max-warnings=0",
    "lint:fix": "pnpm lint:packages --fix && pnpm -r --if-present lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "test:ssr": "node scripts/smoke-ssr.mjs",
    "test:staging": "node scripts/smoke-staging.mjs",
    "test:legal:layout": "node scripts/check-legal-layout.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "prettier": "3.8.1",
    "typescript-eslint": "8.71.1"
  }
}
