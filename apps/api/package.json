{
  "name": "@bdo/api",
  "version": "0.1.0",
  "description": "REST API modular do BDO Companion",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter @bdo/database build && pnpm --filter @bdo/shared build && nest build",
    "typecheck": "pnpm --filter @bdo/database build && pnpm --filter @bdo/shared build && tsc --noEmit -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "pnpm --filter @bdo/database build && pnpm --filter @bdo/shared build && vitest run",
    "data:import": "pnpm build && node dist/catalog/import-game-data.js"
  },
  "dependencies": {
    "@bdo/database": "workspace:*",
    "@bdo/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@types/pg": "^8.23.1",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "vitest": "4.1.11",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.20.0"
  }
}
