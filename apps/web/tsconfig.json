{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@bdo/ui/button": ["./src/app/ui/button/src/index.ts"],
      "@bdo/ui/utils": ["./src/app/ui/utils/src/index.ts"],
      "@bdo/ui/input": ["./src/app/ui/input/src/index.ts"],
      "@bdo/ui/card": ["./src/app/ui/card/src/index.ts"],
      "@bdo/ui/native-select": ["./src/app/ui/native-select/src/index.ts"],
      "@bdo/ui/textarea": ["./src/app/ui/textarea/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
