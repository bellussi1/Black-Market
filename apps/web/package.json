{
  "name": "@bdo/web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm --filter @bdo/calculators build && ng serve --host 0.0.0.0 --poll 1000",
    "build": "pnpm --filter @bdo/calculators build && pnpm --filter @bdo/shared build && ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "pnpm --filter @bdo/calculators build && pnpm --filter @bdo/shared build && ng build --configuration development",
    "lint": "ng lint",
    "test": "pnpm --filter @bdo/calculators build && ng test --watch=false",
    "test:watch": "pnpm --filter @bdo/calculators build && ng test",
    "test:unit": "pnpm --filter @bdo/calculators build && ng test --watch=false --include=\"app/core/**/*.spec.ts\" --include=\"app/features/**/*-api.spec.ts\" --include=\"app/shared/formatters.spec.ts\" --include=\"app/shared/calculation-feedback.spec.ts\"",
    "test:components": "pnpm --filter @bdo/calculators build && ng test --watch=false --include=\"app/features/**/*-page.spec.ts\" --include=\"app/shared/tax-options.spec.ts\" --include=\"app/shared/preset-bar.spec.ts\" --include=\"app/shared/calculation-proof.spec.ts\" --include=\"app/shared/platform-footer/*.spec.ts\" --include=\"app/app.spec.ts\"",
    "lint:fix": "ng lint --fix",
    "i18n:extract": "pnpm --filter @bdo/shared build && pnpm --filter @bdo/calculators build && ng extract-i18n",
    "serve:ssr:web": "node dist/web/server/server.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/localize": "22.2.1",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/ssr": "22.2.2",
    "@bdo/calculators": "workspace:*",
    "@bdo/shared": "workspace:*",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "1.6.3",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "7.0.0",
    "tslib": "^2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.1",
    "@spartan-ng/cli": "1.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.5.0",
    "eslint": "10.12.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
