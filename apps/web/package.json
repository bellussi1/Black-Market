{
  "name": "@bdo/web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm --filter @bdo/calculators build && ng serve --host 0.0.0.0",
    "build": "pnpm --filter @bdo/calculators build && pnpm --filter @bdo/shared build && ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "pnpm --filter @bdo/calculators build && pnpm --filter @bdo/shared build && ng build --configuration development",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
    "test": "pnpm --filter @bdo/calculators build && ng test --watch=false",
    "test:watch": "pnpm --filter @bdo/calculators build && ng test",
    "test:unit": "pnpm --filter @bdo/calculators build && ng test --watch=false --include=\"app/core/**/*.spec.ts\" --include=\"app/features/**/*-api.spec.ts\" --include=\"app/shared/formatters.spec.ts\" --include=\"app/shared/calculation-feedback.spec.ts\"",
    "test:components": "pnpm --filter @bdo/calculators build && ng test --watch=false --include=\"app/features/**/*-page.spec.ts\" --include=\"app/shared/tax-options.spec.ts\" --include=\"app/shared/preset-bar.spec.ts\" --include=\"app/shared/calculation-proof.spec.ts\" --include=\"app/app.spec.ts\""
  },
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@bdo/shared": "workspace:*",
    "@angular/animations": "22.2.1",
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "@bdo/calculators": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.1",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.5.0",
    "eslint": "^9.39.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "4.1.11"
  }
}
